# Put the uv-managed venv and bin/ on PATH so `ifl`, `pytest`, `ruff`, `lint`,
# `format` and `tests` run from this directory without `uv run`. Re-sync when the
# lockfile changes so the venv doesn't drift from it. Anything personal or
# secret goes in .envrc.local, which is git-ignored.
watch_file pyproject.toml uv.lock
uv sync --frozen --quiet
PATH_add .venv/bin
export VIRTUAL_ENV="$PWD/.venv"
source_env_if_exists .envrc.local
PATH_add bin
